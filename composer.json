{
  "name": "softcreatr/php-steam-guard",
  "description": "Dependency-free Steam Guard code generation for PHP",
  "keywords": [
    "Steam",
    "Steam Guard",
    "OTP",
    "2FA",
    "Two Factor Authentication"
  ],
  "homepage": "https://1-2.dev",
  "license": "ISC",
  "authors": [
    {
      "name": "Sascha Greuel",
      "email": "hello@1-2.dev"
    }
  ],
  "require": {
    "php": "^8.1"
  },
  "require-dev": {
    "phpstan/phpstan": "^2.1",
    "phpunit/phpunit": "^10.5 || ^11.5",
    "roave/security-advisories": "dev-latest",
    "squizlabs/php_codesniffer": "^4.0"
  },
  "autoload": {
    "psr-4": {
      "SoftCreatR\\SteamGuard\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "SoftCreatR\\SteamGuard\\Test\\": "test/"
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "scripts": {
    "analyse": "phpstan analyse --no-progress",
    "check": [
      "composer validate --strict --no-check-publish",
      "@cs-check",
      "@analyse",
      "@test"
    ],
    "cs-check": "phpcs",
    "cs-fix": "phpcbf",
    "test": "phpunit --colors=always",
    "test-coverage": "phpunit --colors=always --coverage-clover clover.xml"
  },
  "support": {
    "email": "hello@1-2.dev",
    "issues": "https://github.com/SoftCreatR/php-steam-guard/issues",
    "source": "https://github.com/SoftCreatR/php-steam-guard"
  }
}
